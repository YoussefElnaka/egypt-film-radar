# Egypt Film Radar settings
# Copy this file to ".env" and fill in your own values.
# Don't put spaces around the "=" and don't use quotation marks.

# ---------------------------------------------------------------
# Email (required)
# ---------------------------------------------------------------
# The account that sends the newsletter.
EMAIL_ADDRESS=you@gmail.com

# For Gmail, this must be an App Password (16 letters, no spaces),
# not your normal password: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=abcdefghijklmnop

# Who receives it. For several people, separate with commas, no spaces.
TO_EMAIL=you@gmail.com

# Mail server. The defaults work for Gmail. Examples for others:
#   Fastmail: SMTP_HOST=smtp.fastmail.com  SMTP_PORT=465
#   iCloud:   SMTP_HOST=smtp.mail.me.com   SMTP_PORT=587
# Most providers need an "app password" for this, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Only needed if your mail server login differs from EMAIL_ADDRESS.
SMTP_USER=

# ---------------------------------------------------------------
# TMDB (strongly recommended, free)
# ---------------------------------------------------------------
# Needed to check Netflix, Shahid, OSN+, STARZPLAY, TOD, Prime Video
# and others. Without it, only Yango Play and ElCinema are checked.
# Get one at https://www.themoviedb.org/settings/api (use the 32-character "API Key").
TMDB_API_KEY=

# ---------------------------------------------------------------
# What counts as "performing well"
# ---------------------------------------------------------------
# Minimum ElCinema rating (out of 10).
MIN_RATING=6.0

# Ignore ratings based on fewer votes than this.
MIN_VOTES=20

# Keep re-checking a movie's rating this many weeks after it hits cinemas.
RECHECK_WEEKS=4

# Stop waiting for a streaming release after this many months.
STREAMING_WATCH_MONTHS=12

# ---------------------------------------------------------------
# Email schedule and look
# ---------------------------------------------------------------
# Send at most once every this many days. Schedule the script weekly;
# it skips the weeks in between on its own.
RUN_EVERY_DAYS=14

# Show each movie's Arabic title under the English one (true/false).
SHOW_ARABIC_TITLES=false
